# Sao chép thành .env rồi điền key. KHÔNG commit .env (đã có trong .gitignore).
# LLM: DeepSeek V4.1 Flash qua OpenCode Go (docs/DECISIONS.md, D2). Key tạo trong OpenCode Console.
OPENCODE_API_KEY=

# Tuỳ chọn (bỏ dấu # để dùng):
# DCG_MODEL=deepseek-v4.1-flash      # model khác trên OpenCode Go, vd. cho critic khác họ model
# DCG_TEMPERATURE=0
# DCG_MIN_INTERVAL=1                 # giây tối thiểu giữa hai lần bắt đầu request
